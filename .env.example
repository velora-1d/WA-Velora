# ===========================================
# Velora - Production Example
# Copy to .env and edit the placeholder values.
# ===========================================

NODE_ENV=production
API_PORT=2785
DOMAIN=wa.santrix.my.id

# Public URL
BASE_URL=https://wa.santrix.my.id
CORS_ORIGINS=https://wa.santrix.my.id

# Set your own long random key before deploy
API_MASTER_KEY=replace_with_long_random_api_key

# SQLite: simplest setup, no separate DB service
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
MAIN_DATABASE_SYNCHRONIZE=true

# WhatsApp engine
ENGINE_TYPE=whatsapp-web.js
AUTO_START_SESSIONS=false
SESSION_DATA_PATH=./data/sessions
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

# Local storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

# Optional built-ins disabled
POSTGRES_BUILTIN=false
REDIS_ENABLED=false
REDIS_BUILTIN=false
MINIO_BUILTIN=false

# Webhook defaults
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_SSRF_PROTECT=true

# API protection
RATE_LIMIT_MEDIUM_TTL=60000
RATE_LIMIT_MEDIUM_LIMIT=100

# Optional
ENABLE_SWAGGER=true
BODY_SIZE_LIMIT=25mb
